# Segredo de assinatura do JWT de sessão. Obrigatório em produção.
# Gere o seu com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Senha dos usuários semente criados no primeiro boot (padrão: portal2026).
# Só serve para a demo — um deploy real usa SSO corporativo.
SEED_PASSWORD=

# Conexão com o Postgres. Dentro do compose o app usa o host "postgres";
# rodando "npm run dev" na máquina, aponte para a porta publicada.
DATABASE_URL=postgres://portal:portal@127.0.0.1:5433/portal
POSTGRES_PASSWORD=portal
